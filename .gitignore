# PDF papers — large files, copyright restrictions

# Python cache
__pycache__/
*.py[cod]
*.pyc

# OS
.DS_Store
Thumbs.db

# Obsidian workspace state (local to each user)
wiki/.obsidian/workspace.json
wiki/.obsidian/workspace-mobile.json

# Environment
.env
*.env
.venv/

# Training / harness artifacts (sharedlm)
# NOTE: anchored with a leading slash. An unanchored `runs/` matches ANY directory named
# `runs` at any depth — which silently ignored every per-run result under results/runs/.
/runs/
data/*.bin
*.pt
.pytest_cache/
.loop/uv_sync.log
/runs_iso*/
runs*.log
.train_pid

# Claude worktrees (session isolation)
.claude/worktrees/

# CLAUDE.md is PERSONAL to each machine and must never be shared.
# Hazar's is a RenOS pointer with machine-local paths; Alper's points at
# COLLABORATOR.md. The shared executor rules live in COLLABORATOR.md, which IS
# tracked — so they are versioned and survive a re-clone, while the file that
# loads them stays local to whoever is working.
/CLAUDE.md
